{
  "name": "justable",
  "version": "0.1.0",
  "description": "A windowed, keyboard-navigable data table for React: column model, grid, header, rows and auto-fit, themed through --table-* CSS variables.",
  "license": "MIT",
  "author": "Ki Hyun Park",
  "repository": {
    "type": "git",
    "url": "https://github.com/kihyun1998/justable.git"
  },
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./style.css": "./dist/style.css"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && tailwindcss -i src/style.css -o dist/style.css",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "peerDependencies": {
    "lucide-react": ">=0.500.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@tailwindcss/cli": "~4.2.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^24.0.0",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "jsdom": "^29.1.1",
    "lucide-react": "^0.577.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "tailwindcss": "~4.2.1",
    "typescript": "~7.0.2",
    "vitest": "^4.1.5"
  }
}
